root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# 浏览器半是 ModuleLoader 单文件，历史缩进是 tab，别改
[src/client/*.js]
indent_style = tab
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
